# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# For hosted: Project Settings -> API. Use the new "Publishable" + "Secret" keys
# (sb_publishable_… and sb_secret_…). The legacy anon + service_role names are
# also supported for backwards compatibility.
# For local Docker (`supabase start`), the CLI prints them on startup.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallbacks (only one of each pair is needed):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---
# Optional. If missing, emails are logged to the console and recorded as `sent_mock`.
RESEND_API_KEY=
RESEND_FROM_EMAIL="IntakeClean <noreply@intakeclean.app>"

# --- SMS (Twilio) ---
# Optional. If missing, SMS messages are logged to the console and recorded as `sent_mock`.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Stripe ---
# Optional in dev. Set DEV_BYPASS_BILLING=true to mark every org as active.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_FIRM=

# --- Google Document AI ---
# Optional. If missing, the mock processor returns realistic random quality flags
# and is labelled "Mock analysis" in the dev UI.
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
# JSON-encoded service account credentials (single line).
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- OpenAI ---
# Optional. If missing, classification falls back to keyword/filename heuristics.
OPENAI_API_KEY=

# --- Dev flags ---
DEV_BYPASS_BILLING=true
ADMIN_DEBUG=true
