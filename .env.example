# =============================================================================
# IntakeClean — environment variables
# =============================================================================
# Copy this file to .env.local and fill in the values you need. The app is
# designed so that only the Supabase keys are strictly required — every other
# integration falls back to an in-process mock when its credentials are
# missing.
#
# When deploying to Vercel, configure these in the Project Settings →
# Environment Variables tab (or via `vercel env add <NAME>`).
# -----------------------------------------------------------------------------

# ----- Public app URL ---------------------------------------------------------
# Set to your production URL on Vercel (e.g. https://intakeclean.vercel.app or
# your custom domain). Used in transactional emails, SMS links, and OG tags.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Supabase (REQUIRED) ----------------------------------------------------
# Project URL, publishable (anon) key, and secret (service role) key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy aliases also accepted:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
#
# When Supabase is installed via the Vercel Marketplace integration, Vercel
# auto-provisions the same values under a STORAGE_ prefix. The app reads
# either set of names, so you do NOT need to rename them in the Vercel
# dashboard. The marketplace names look like this:
#   NEXT_PUBLIC_STORAGE_SUPABASE_URL
#   NEXT_PUBLIC_STORAGE_SUPABASE_PUBLISHABLE_KEY (or _ANON_KEY)
#   STORAGE_SUPABASE_SECRET_KEY                   (or _SERVICE_ROLE_KEY)

# ----- Document AI pipeline ---------------------------------------------------
# `mock` works with no external services. Switch to a real provider only after
# you have signed a DPA with that subprocessor.
AI_PROVIDER=mock              # mock | local_ocr_only | huggingface_provider | huggingface_endpoint
OCR_ENGINE=tesseract          # tesseract | paddleocr | mock | none
USE_LOCAL_OCR=true
USE_HF_CLASSIFICATION=false
USE_HF_EXPLANATIONS=false
# Multimodal vision review of uploaded photos (passport pages, IDs, court
# forms, etc.). OFF by default. When on, we send the 600px-wide JPEG
# *thumbnail* (not the original image) to HF_VISION_MODEL with a strict
# prompt that forbids transcribing PII. The per-firm `use_hf_vision`
# toggle in Settings → Document AI must ALSO be on before any image
# leaves the platform — this env flag is the global kill-switch.
USE_HF_VISION=false
MOCK_AI=true
TESSERACT_LANG=eng

# Hugging Face (only required if AI_PROVIDER=huggingface_*):
# HF_TOKEN=
# HF_INFERENCE_ENDPOINT_URL=
# HF_DOCUMENT_MODEL=docling-project/SmolDocling-256M-preview
# HF_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# HF_TEXT_MODEL=Qwen/Qwen2.5-3B-Instruct
#
# Vision-model recommendations:
#   - Qwen/Qwen2.5-VL-7B-Instruct (default; strong on documents, fits within
#     the HF Inference Provider tier)
#   - meta-llama/Llama-3.2-11B-Vision-Instruct (better OCR-style tasks)
# For maximum privacy, point HF_INFERENCE_ENDPOINT_URL at a dedicated HF
# Inference Endpoint you control instead of using the multi-tenant
# Inference Provider — bytes never reach a 3rd-party provider then.

# ----- Email (Resend) — optional ---------------------------------------------
# Without these, sendEmail() falls back to a console-logged mock and
# client_messages are written with status="sent_mock". To send real mail:
#   1. Get an API key at resend.com/api-keys
#   2. Verify a sending subdomain (conventionally `send.YOURDOMAIN.com`) by
#      publishing the four DNS records from docs/security/email-domain-auth.md
#   3. Wait for Resend dashboard to show "Verified" before setting
#      RESEND_FROM_EMAIL — otherwise every send returns
#      "domain not verified" and lands in client_messages with status="failed".
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=IntakeClean <noreply@send.YOURDOMAIN.com>

# ----- SMS (Twilio) — optional -----------------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ----- Billing (Stripe) — optional -------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_SOLO=
# STRIPE_PRICE_FIRM=

# ----- Cron / internal endpoints ---------------------------------------------
# Vercel Cron and other internal HTTP triggers should send
# `Authorization: Bearer ${CRON_SECRET}`. Generate with `openssl rand -hex 32`.
# CRON_SECRET=

# ----- Rate limiting (Upstash) -----------------------------------------------
# Required in production. Without these, rate limits fall back to in-memory
# per-instance counters that don't share state across serverless functions.
# Provision via the Upstash integration in the Vercel Marketplace; both the
# native UPSTASH_* names and the marketplace-aliased KV_* names are accepted.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ----- Bot protection (Vercel BotID) -----------------------------------------
# Required in production for the public /upload/[token] portal. Provision
# from the Vercel dashboard; once enabled, the verify token is auto-injected
# at runtime — no env var to set.

# ----- Antivirus (Cloudmersive) — optional -----------------------------------
# When set, uploaded files are scanned before being made visible to staff
# in the review queue. Falls back to a no-op (with a warning logged) when
# missing so dev still works.
# CLOUDMERSIVE_API_KEY=

# ----- Observability (Sentry) — optional -------------------------------------
# Both server and edge SDKs read SENTRY_DSN; the client SDK reads
# NEXT_PUBLIC_SENTRY_DSN (intentionally a separate value so you can use a
# separate Sentry project for browser errors). All events are passed through
# the PII scrubber in src/lib/observability/scrub.ts.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ----- Dev convenience --------------------------------------------------------
# DEV_BYPASS_BILLING=true      # Treat every org as if it had an active sub
# ADMIN_DEBUG=true             # Show "Dev tools" sidebar entry for admins

# =============================================================================
# Supabase project settings (configure these in the Supabase Dashboard, not
# in this file). Required for production:
#   - Auth -> Multi-Factor Authentication: enable TOTP factors
#   - Auth -> Password: enable "leaked password" check (HIBP) and require
#     min length 12 + at least one number/letter
#   - Auth -> Session: access-token TTL 1h, rotate refresh tokens
#   - Auth -> Email: enable "Confirm email" before sign-in
#   - Database -> Backups: turn on Point-In-Time Recovery (Pro tier)
#   - Database -> Advisor: review weekly; act on RLS / missing-index warnings
# =============================================================================
